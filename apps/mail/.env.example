# Copy to .dev.vars for local dev and set the same values as Worker secrets.
# Values are never committed. See README.md.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

B2_JSON_PREFIX=emails
DEFAULT_FROM_EMAIL=noreply@onlyorders.tech
DEFAULT_FROM_NAME=OnlyOrders
MAX_SEND_BYTES=10485760

# Generated per environment. Required for every /api route.
MAIL_API_KEY=

# Brevo transactional API (primary provider).
BREVO_API_KEY=
# Optional: force "brevo" or "sender.net" when both keys exist.
MAIL_SEND_PROVIDER=
# Optional verified Brevo sender for tests; defaults to DEFAULT_FROM_EMAIL.
BREVO_TEST_SENDER=

# Optional Sender.net fallback (Bearer token).
SENDER_API_KEY=
SENDER_TEST_SENDER=

# Mailosaur live receive test (scripts/test-provider.ts).
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER=
MAILOSAUR_TEST_ADDRESS=
