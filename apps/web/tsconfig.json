{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,
    "declarationMap": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@repo/db": ["../../packages/db"],
      "@repo/db/*": ["../../packages/db/*"],
      "@repo/shared": ["../../packages/shared"],
      "@repo/shared/*": ["../../packages/shared/*"],
      "@repo/integrations": ["../../packages/integrations"],
      "@repo/integrations/*": ["../../packages/integrations/*"],
      "@db/*": ["../../packages/db/*"],
      "@shared/*": ["../../packages/shared/*"]
    },
    "noEmit": true,
    "incremental": true,
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
