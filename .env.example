# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
NEON_DATABASE_URL=

# Firebase Admin (API token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web (Next.js public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Gemini
GEMINI_API_KEY=

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=oryxa-webhook-verify
META_REDIRECT_URI=http://localhost:3001/api/v1/auth/facebook/callback
# Ask for business_management so Pages owned by a Business Portfolio show up in the picker.
# Only set 'true' after Meta grants Advanced Access for it — a Live app requesting an
# unapproved permission blocks the whole login, not just that permission.
META_BUSINESS_MANAGEMENT=
# Set to 'true' to proxy all incoming Meta webhook requests to https://api.oryxa.us (fire-and-forget)
TESTING=false


# Internal agent runner (self-referential on Vercel)
INTERNAL_KEY=change-me-to-random-secret
AGENT_RUNNER_URL=http://localhost:3001

# Backblaze B2 (S3-compatible — private bucket, signed URLs)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
# Presigned URL lifetime in seconds (default 3600)
B2_SIGNED_URL_TTL_SECONDS=3600

# The brand word every page of the web UI prints — navbar, login, footer, Terms, Privacy, the
# storefront's "Powered by". Read by apps/web only, and at BUILD time: next.config.ts lists it
# under `env`, so it is inlined into the browser bundle as well as the server, and one value
# renames the product everywhere without a NEXT_PUBLIC_ twin.
COMPANY_NAME=Oryxa

# The legal entity the product belongs to, which is the name the Terms, Privacy and data-deletion
# pages contract under — "owned, developed, and operated by", the copyright line, the support
# address. Kept apart from COMPANY_NAME because they genuinely differ: the shop a customer sees
# is not the company that holds the liability. Same build-time inlining as above.
PARENT_COMPANY_NAME=RR Computer

# The credential behind the admin panel's "Change Name to …" button. It writes the two variables
# above on the web project in Vercel and starts a production build, because both names are inlined
# at build time. Read by apps/api2 only.
#
# A `vcp_` personal access token is the whole account — every project, every secret. On a machine
# that faces the internet, prefer a Deploy Token scoped to the web project alone and leave this
# unset; the button then refuses rather than writing with a key it does not have.
#
# Rehearse without the button: `bun apps/api2/scripts/toggle-brand.ts` prints the swap and writes
# nothing. Add --apply to perform it.
VERCEL_PERSONA_KEY=
# Which Vercel projects the button re-brands. Defaults to oryxa-web and oryxa-api2.
VERCEL_WEB_PROJECT=oryxa-web
VERCEL_API_PROJECT=oryxa-api2

# API / Web URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3400

# Dev ports
API_PORT=3001
API2_PORT=3500
WEB_PORT=3400

# Admin console (/admin, /admin/logs). Read by BOTH apps/web and apps/api: the web app presents it
# as the bearer, the API compares it. Outside production the defaults admin123 /
# admin123 apply; in production the password must be set or the console has no
# login path at all. Choose something not guessable — it opens every tenant's logs.
LOGS_UI_USER=admin123
LOGS_UI_PASSWORD=change-me
# Or let a real account in instead: comma-separated user ids, no password needed.
LOG_QUERY_USER_IDS=
