# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
NEON_DATABASE_URL=

# Firebase Admin (API token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web (Next.js public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web push certificate key from Firebase console > Project settings > Cloud Messaging.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Gemini
GEMINI_API_KEY=

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=oryxa-webhook-verify
META_REDIRECT_URI=http://localhost:3001/api/v1/auth/facebook/callback
# Ask for business_management so Pages owned by a Business Portfolio show up in the picker.
# Only set 'true' after Meta grants Advanced Access for it — a Live app requesting an
# unapproved permission blocks the whole login, not just that permission.
META_BUSINESS_MANAGEMENT=
# Set to 'true' to proxy all incoming Meta webhook requests to https://api.oryxa.us (fire-and-forget)
TESTING=false


# Internal agent runner (self-referential on Vercel). INTERNAL_KEY must be a unique random
# secret of at least 16 characters; with it unset or shorter, every /internal request is rejected.
INTERNAL_KEY=
AGENT_RUNNER_URL=http://localhost:3001

# Backblaze B2 (S3-compatible — private bucket, signed URLs)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
# Presigned URL lifetime in seconds (default 3600)
B2_SIGNED_URL_TTL_SECONDS=3600

# The credential behind the API's legacy brand-swap route. It writes the two variables
# above on the web project in Vercel and starts a production build, because both names are inlined
# at build time. Read by apps/api2 only.
#
# A `vcp_` personal access token is the whole account — every project, every secret. On a machine
# that faces the internet, prefer a Deploy Token scoped to the web project alone and leave this
# unset; the button then refuses rather than writing with a key it does not have.
#
# Rehearse without the button: `bun apps/api2/scripts/toggle-brand.ts` prints the swap and writes
# nothing. Add --apply to perform it.
VERCEL_PERSONA_KEY=
# Which Vercel projects the button re-brands. Defaults to oryxa-web and oryxa-api2.
VERCEL_WEB_PROJECT=oryxa-web
VERCEL_API_PROJECT=oryxa-api2

# API / Web URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3400

# Dev ports
API_PORT=3001
API2_PORT=3500
WEB_PORT=3400

# Admin console (/admin, /admin/logs). Read by BOTH apps/web and apps/api: the web app presents it
# as the bearer, the API compares it. There is no default password in any environment; it must be
# set to at least 12 characters, and "change-me" is refused, so an unset or weak value closes the
# console rather than opening it. Choose something not guessable — it opens every tenant's logs.
LOGS_UI_USER=
LOGS_UI_PASSWORD=

# Axiom (log ingest and the /admin/logs storage panel). AXIOM_QUERY_TOKEN needs read access;
# AXIOM_TOKEN may be ingest-only. Leave AXIOM_ENABLED unset to keep events in this process.
AXIOM_ENABLED=
AXIOM_TOKEN=
AXIOM_QUERY_TOKEN=
AXIOM_DATASET=
# Storage allowance in GB shown on /admin/logs. Defaults to Axiom's 100 GB always-free allowance;
# set this when the organization is on a paid plan with a different storage allowance.
AXIOM_STORAGE_LIMIT_GB=

# WhatsApp Cloud API webhook security and the operator platform secret for cloud users
# (spec E). WA_WEBHOOK_APP_SECRET signs webhook payloads; MESSAGES_ENCRYPTION_KEY encrypts
# channel bearer tokens at rest (32-byte key or passphrase).
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
MESSAGES_ENCRYPTION_KEY=
# Or let a real account in instead: comma-separated user ids, no password needed.
LOG_QUERY_USER_IDS=

# Meta webhook signature: enforced (403 on bad/missing X-Hub-Signature-256). Set to log-only ONLY to debug a secret mismatch.
# log-only is ignored in production, where signatures are always enforced.
META_WEBHOOK_SIGNATURE_MODE=enforce

# The dev-test-token auth bypass. Both this and a non-production NODE_ENV are required.
ALLOW_DEV_AUTH_BYPASS=false
# Serve OpenAPI /doc and Swagger /ui in production. Off outside production, off by default in production.
ENABLE_API_DOCS=false

# CORS: extra allowed browser origins (comma-separated). WEB_URL is always allowed; localhost only outside production.
CORS_ORIGINS=
# Operators (exact emails, comma-separated) who may open the oryxa-sandbox store.
ADMIN_EMAILS=
